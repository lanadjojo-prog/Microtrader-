# Alpaca credentials. Add real values in Render; never commit them.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Safety: paper mode is on by default.
ALPACA_PAPER=true
LIVE_TRADING_ENABLED=false
AUTO_START=false
DASHBOARD_TOKEN=replace-with-a-long-random-secret

# Scanner
SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMD,AMZN,META,GOOGL,TSLA
POLL_SECONDS=20
BARS_LOOKBACK=30
FAST_WINDOW=4
SLOW_WINDOW=12
ENTRY_EDGE_BPS=8
EXIT_EDGE_BPS=1
ALPACA_DATA_FEED=iex

# Risk / size
TRADE_NOTIONAL=3
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_DAY=100
MAX_DAILY_LOSS=5
TAKE_PROFIT_PCT=0.004
STOP_LOSS_PCT=0.003
COOLDOWN_SECONDS=60
KILL_CLOSE_POSITIONS=true

# Strategy Lab
LAB_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMD,AMZN,META,GOOGL,TSLA
LAB_LOOKBACK_DAYS=60
LAB_TIMEFRAME=5Min
LAB_MAX_BARS_PER_SYMBOL=5000
LAB_COST_BPS=2.5
LAB_STRESS_COST_MULTIPLIER=2.0
LAB_MIN_OOS_TRADES=30

# Continuous Strategy Lab
LAB_CONTINUOUS=true
LAB_AUTO_START=true
LAB_TARGET_PROMOTED=3
LAB_BATCH_SIZE=25
LAB_MIN_OOS_TRADES=100
LAB_MIN_PROFIT_FACTOR=1.15
LAB_MAX_DRAWDOWN_PCT=6
LAB_MIN_POSITIVE_SYMBOL_RATIO=0.60
