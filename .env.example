# Alpaca credentials. Add real values in Render; never commit them.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Safety: paper mode is on by default.
ALPACA_PAPER=true
LIVE_TRADING_ENABLED=false
AUTO_START=false
DASHBOARD_TOKEN=replace-with-a-long-random-secret

# Scanner
SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMD,AMZN,META,GOOGL,TSLA
POLL_SECONDS=20
BARS_LOOKBACK=30
FAST_WINDOW=4
SLOW_WINDOW=12
ENTRY_EDGE_BPS=8
EXIT_EDGE_BPS=1
ALPACA_DATA_FEED=iex

# Risk / size
TRADE_NOTIONAL=3
MAX_OPEN_POSITIONS=5
MAX_TRADES_PER_DAY=100
MAX_DAILY_LOSS=5
TAKE_PROFIT_PCT=0.004
STOP_LOSS_PCT=0.003
COOLDOWN_SECONDS=60
KILL_CLOSE_POSITIONS=true

# Strategy Lab
LAB_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,AMD,AMZN,META,GOOGL,TSLA
LAB_LOOKBACK_DAYS=60
LAB_TIMEFRAME=5Min
LAB_MAX_BARS_PER_SYMBOL=5000
LAB_COST_BPS=2.5
LAB_STRESS_COST_MULTIPLIER=2.0
LAB_MIN_OOS_TRADES=30

# Continuous Strategy Lab
LAB_CONTINUOUS=true
LAB_AUTO_START=true
LAB_TARGET_PROMOTED=3
LAB_BATCH_SIZE=25
LAB_MIN_OOS_TRADES=100
LAB_MIN_PROFIT_FACTOR=1.15
LAB_MAX_DRAWDOWN_PCT=6
LAB_MIN_POSITIVE_SYMBOL_RATIO=0.60

# Forex-first mode (keep legacy stock/crypto code dormant)
FOREX_FIRST=false
FOREX_LAB_AUTO_START=false
FOREX_PAIRS=EUR/USD,GBP/USD,USD/JPY
FOREX_START_CAPITAL_EUR=50
FOREX_RISK_EUR=0.75
FOREX_COST_BPS=0.50
FOREX_STRESS_COST_MULTIPLIER=2.0
FOREX_LOOKBACK_DAYS=120
FOREX_MAX_BARS_PER_PAIR=12000
FOREX_LAB_BATCH_SIZE=12
FOREX_MIN_OOS_TRADES=60
FOREX_MIN_PROFIT_FACTOR=1.25
FOREX_MIN_PAYOFF_RATIO=1.80

# cTrader / Fusion demo. Fill these only in Render environment variables.
CTRADER_ENVIRONMENT=demo
# Hard safety lock: while true, live cTrader endpoints and trading OAuth scope are rejected.
CTRADER_DEMO_ONLY=true
# Read-only account/data access. Keep this at accounts until live execution is intentionally designed.
CTRADER_OAUTH_SCOPE=accounts
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=https://microtrader-6thu.onrender.com/ctrader/callback
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=

# Precision Lab: separate tight-stop tester.
# Uses 3/4 pip stops, 5..10 pip targets and bid/ask historical tick execution.
PRECISION_LAB_AUTO_START=false
PRECISION_PAIRS=EUR/USD
PRECISION_LOOKBACK_DAYS=7
PRECISION_MAX_BARS_PER_PAIR=12000
PRECISION_MAX_TICKS_PER_SIDE=250000
PRECISION_BATCH_SIZE=12
PRECISION_START_CAPITAL_EUR=50
PRECISION_RISK_EUR=0.75
PRECISION_COMMISSION_PIPS=0.50
PRECISION_STRESS_MULTIPLIER=2.0
PRECISION_MIN_OOS_TRADES=40
PRECISION_MIN_PROFIT_FACTOR=1.20
